# -------------------------
# LLM CONFIGURATION
# -------------------------
LLM_PROVIDER=openai

# Use global environment variable (DO NOT hardcode key here)
# OPENAI_API_KEY=

# Cheap + fast model (recommended)
OPENAI_MODEL=gpt-4o-mini

# Optional: enable debug logs for LLM
ENABLE_LLM_LOGGING=true


# -------------------------
# PLAYWRIGHT SETTINGS
# -------------------------
BROWSER=chromium
HEADLESS=true
SLOW_MO=0
DEFAULT_TIMEOUT=10000


# -------------------------
# HEALING ENGINE SETTINGS
# -------------------------
HEALING_MODE=hybrid          # IMPORTANT: enables LLM + heuristic

MAX_HEAL_ATTEMPTS=3
MAX_LLM_CANDIDATES=5

# Trigger LLM when heuristic is uncertain
MIN_HEURISTIC_SCORE=0.60     # ↑ from 0.45 (more LLM usage)


# -------------------------
# HEURISTIC ENGINE TUNING
# -------------------------
MAX_HEURISTIC_VALIDATE=12
MAX_HEURISTIC_TRY=4
HEURISTIC_VALIDATE_TIMEOUT=1500


# -------------------------
# MEMORY SYSTEM
# -------------------------
ENABLE_REPAIR_MEMORY=true


# -------------------------
# DEBUG / LOGGING
# -------------------------
ENABLE_EXPERIMENT_LOGGING=true
LOG_ONLY_FAILURES=false
CAPTURE_SCREENSHOT_ON_FAILURE=false